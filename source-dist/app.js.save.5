async function queryResearchLocation(query, lngLat, outFields) {
  const params = new URLSearchParams({
    where: '1=1', geometry: `${lngLat.lng},${lngLat.lat}`, geometryType: 'esriGeometryPoint', inSR: '4326',
    spatialRel: 'esriSpatialRelIntersects', outFields, returnGeometry: 'false', resultRecordCount: '25', f: 'json'
  });
  const response = await fetch(`${query}?${params}`);
  if (!response.ok) throw new Error(`Location research: ${response.status}`);
  const data = await response.json();
  return data.features || [];
}

