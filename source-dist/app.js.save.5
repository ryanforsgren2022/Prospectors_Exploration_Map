// AEM_AZ_ROAD_PARITY_V5: Arizona access/path and zoom parity on unified OSM roads.
// AEM_WESTERN_STYLE_V3: presentation only; the unified PMTiles data is unchanged.
// All widths below are pixels interpolated by map zoom. Tune here, not per state.
// AEM_ROAD_OPACITY_HIDE_DEVBOX_V4
function westernRoadStyles() {
  const groups = WESTERN_ROAD_GROUPS;
  const hide = { visibility: 'none', 'line-cap': 'round', 'line-join': 'round' };
  // AEM_ROAD_CLASS_FINAL_V1
  // Designated FR/FS/BLM roads retain priority regardless of highway subclass.
  const lower = (key) =>
    ['downcase', ['to-string', ['coalesce', ['get', key], '']]];
  const starts = (value, prefix) =>
    ['==', ['slice', value, 0, prefix.length], prefix];

  const ref = lower('ref');
  const name = lower('name');

  const managed = ['all',
    ['!', ['match', ['get', 'highway'],
      ['path', 'footway', 'cycleway', 'bridleway', 'pedestrian', 'steps'],
      true, false]],
    ['any',
      starts(ref, 'fr'),
      starts(ref, 'fs'),
      starts(ref, 'blm'),
      starts(ref, 'nfsr'),
      starts(name, 'forest road '),
      starts(name, 'forest service '),
      starts(name, 'national forest development road'),
      starts(name, 'blm '),
      starts(name, 'bureau of land management ')
    ]
  ];

  const minorService = ['all',
    ['==', ['get', 'highway'], 'service'],
    ['any',
      ['match', ['get', 'service'],
        ['driveway', 'parking_aisle'], true, false],
      ['match', ['get', 'subclass'],
        ['driveway', 'parking_aisle'], true, false]
    ]
  ];

  const matches = (highways) => {
    if (highways === groups.managed) return managed;
    const raw = ['match', ['get', 'highway'], highways, true, false];
    if (highways === groups.access)
      return ['all', raw, ['!', managed]];
    if (highways === groups.local || highways === groups.secondary)
      return ['all', raw, ['!', managed], ['!', minorService]];
    return raw;
  };
  const hasText = (key) => ['all', ['has', key], ['!=', ['get', key], '']];
  const noRef = ['!', hasText('ref')];
  // Evaluate the same two-level offset in the style, without resetting filters on zoom.
  const roadVisibleAtZoom = ['<=', ['to-number', ['get', 'tippecanoe:minimumzoom'], 0], ['+', ['floor', ['zoom']], 2]];

  const line = (id, highways, minzoom, color, stops, extras = {}) => ({
    id, type: 'line', source: 'roads', 'source-layer': 'roads', minzoom,
    filter: ['all', matches(highways), roadVisibleAtZoom], layout: { ...hide },
    paint: {
      'line-color': color,
      'line-width': ['interpolate', ['linear'], ['zoom'], ...stops],
      ...extras,
      'line-opacity': 1
    }
  });

  // Route refs take priority over road names. Do not show both on the same road.
  // The converter stores missing refs/names as empty strings, not nulls.
  const refText = ['get', 'ref'];
  const nameText = ['get', 'name'];
  const label = (id, highways, minzoom, text, eligible, priority, size, bold = false) => ({
    id, type: 'symbol', source: 'roads', 'source-layer': 'roads', minzoom,
    filter: ['all', matches(highways), eligible, roadVisibleAtZoom],
    layout: {
      visibility: 'none',
      'symbol-placement': 'line',
      'symbol-sort-key': priority,
      'text-field': text,
      'text-font': [bold ? 'Noto Sans Bold' : 'Noto Sans Regular'],
      'text-size': size,
      'symbol-spacing': priority < 4 ? 460 : 550,
      'text-max-angle': 40,
      'text-padding': 10,
      'text-keep-upright': true,
      'text-optional': true,
      'text-allow-overlap': false,
      'text-ignore-placement': false
    },
    paint: {
      'text-color': '#f9f9f9',
      'text-halo-color': '#101010',
      'text-halo-width': bold ? 1.7 : 1.4
    }
  });

  // Layer order matters: paths/access underneath major routes so white
  // highways remain continuous where roads intersect.
  const haloLayers = [
    line('western-trails', groups.trail, 8.5, '#101010',
      [10.5, 0.8, 14, 1.15, 18, 1.8], { 'line-dasharray': [2, 2] }),

    // Reveal road classes progressively as the map zooms in.
    line('access-roads-casing', groups.access, 8.5, '#d3d3d3',
      [9, 1.05, 12, 1.5, 14, 1.82, 18, 2.65], { 'line-opacity': 0.77 }),
    line('access-roads', groups.access, 8.5, '#050505',
      [9, 0.72, 12, 1.10, 14, 1.45, 18, 2.2]),

    line('local-road-casing', groups.local, 10.5, '#d5d5d5',
      [10, 0.98, 14, 1.55, 18, 2.45], { 'line-opacity': 0.75 }),
    line('local-roads', groups.local, 10.5, '#080808',
      [10, 0.57, 14, 1.08, 18, 1.9]),

    line('secondary-road-casing', groups.secondary, 7, '#e7e7e7',
      [9, 1.22, 14, 2.0, 18, 2.95], { 'line-opacity': 0.82 }),
    line('secondary-roads', groups.secondary, 7, '#030303',
      [9, 0.75, 14, 1.47, 18, 2.35]),

    // Managed roads remain black across OSM highway subclasses.
    line('managed-road-casing', groups.managed, 7, '#f2f4f3',
      [9, 1.7, 12, 2.2, 14, 2.8, 18, 3.5]),
    line('managed-roads', groups.managed, 7, '#050505',
      [9, 1.0, 12, 1.5, 14, 2.1, 18, 2.7]),

    // Major numbered roads remain white and draw on top of minor roads.
    line('state-road-casing', groups.state, 6.1, '#070707',
      [8.1, 1.5, 12, 2.5, 18, 3.5]),
    line('state-roads', groups.state, 6.1, '#ffffff',
      [8.1, 0.88, 12, 1.7, 18, 2.6]),
    line('primary-road-casing', groups.major, 2, '#050505',
      [4, 1.7, 12, 3.15, 18, 4.5]),
    line('primary-roads', groups.major, 2, '#ffffff',
      [4, 1.08, 12, 2.2, 18, 3.35]),

    // Numeric/ref labels take priority; don't also draw the street name.
    label('primary-route-labels', groups.major, 2, refText, hasText('ref'), 1, 13, true),
    label('state-route-labels', groups.state, 6.1, refText, hasText('ref'), 2, 12.5, true),
    label('other-numbered-route-labels', groups.secondary, 6.1, refText, hasText('ref'), 3, 11.5, true),
    label('forest-road-labels', groups.managed, 7, refText, hasText('ref'), 4, 11, true),

    label('primary-road-name-labels', groups.major, 10, nameText,
      ['all', noRef, hasText('name')], 5, 12),
    label('arterial-road-name-labels', groups.state, 9.5, nameText,
      ['all', noRef, hasText('name')], 6, 11.5),
    label('main-street-labels', groups.secondary, 10, nameText,
      ['all', noRef, hasText('name')], 7, 11),
    label('local-labels', groups.local, 11.5, nameText,
      ['all', noRef, hasText('name')], 8, 10.5),
    label('managed-road-name-labels', groups.managed, 8.5, nameText,
      ['all', noRef, hasText('name')], 8, 10.5),
    label('access-labels', groups.access, 9.5, nameText,
      ['all', noRef, hasText('name')], 9, 10.5),
    label('western-trail-labels', groups.trail, 11, nameText,
      ['all', noRef, hasText('name')], 10, 10.5)
  ];

  // AEM_ROAD_HALOS_V11
  // Adjust existing casings only; preserve road centerlines.

  const roadPairs = [
    ['primary-roads', 'primary-road-casing'],
    ['state-roads', 'state-road-casing'],
    ['secondary-roads', 'secondary-road-casing'],
    ['local-roads', 'local-road-casing'],
    ['access-roads', 'access-roads-casing'],
    ['managed-roads', 'managed-road-casing']
  ];

  const byId = Object.fromEntries(
    haloLayers.map(layer => [layer.id, layer])
  );

  for (const [roadId, casingId] of roadPairs) {
    const road = byId[roadId];
    const casing = byId[casingId];

    if (!road || !casing) {
      throw new Error('Missing halo pair: ' + roadId);
    }

    const color = String(road.paint['line-color']);
    const bright =
      /^#(?:f|e)[0-9a-f]{5}$/i.test(color) ||
      /^rgba?\(\s*2[0-5]\d/i.test(color);

    casing.paint['line-color'] = bright
      ? '#080c0e'
      : '#f2f4f3';

    casing.paint['line-opacity'] = 1;

    const width = casing.paint['line-width'];

    if (
      Array.isArray(width) &&
      width[0] === 'interpolate' &&
      width[2]?.[0] === 'zoom'
    ) {
      casing.paint['line-width'] = width.map(
        (value, index) =>
          index >= 4 && index % 2 === 0
            ? value + 0.6
            : value
      );
    }
  }

  return haloLayers;
}

