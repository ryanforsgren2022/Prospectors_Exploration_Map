function getVisitedHistoricMineIds() {
  try {
    const saved = JSON.parse(window.localStorage.getItem(VISITED_HISTORIC_MINES_STORAGE_KEY) || '[]');
    return new Set(Array.isArray(saved) ? saved.map(String) : []);
  } catch (error) {
    console.warn('Visited historic mines could not be read:', error.message);
    return new Set();
  }
}

const visitedHistoricMineIds = getVisitedHistoricMineIds();

function saveVisitedHistoricMineIds() {
  try {
    window.localStorage.setItem(VISITED_HISTORIC_MINES_STORAGE_KEY, JSON.stringify([...visitedHistoricMineIds]));
  } catch (error) {
    console.warn('Visited historic mines could not be saved:', error.message);
  }
}

function setHistoricMineVisited(depId, visited) {
  const id = String(depId);
  if (visited) visitedHistoricMineIds.add(id);
  else visitedHistoricMineIds.delete(id);
  saveVisitedHistoricMineIds();
  try {
    for (const [stateCode] of prospectorStateRegistry) {
      const source = `prospector-${stateCode}-historic-mines`;
      const layer = map.getLayer(`prospector-${stateCode}-${HISTORIC_MINES_ARCHIVE_LAYER_ID}`);
      if (map.getSource(source) && layer) map.setFeatureState({ source, sourceLayer: layer['source-layer'] || HISTORIC_MINES_ARCHIVE_SOURCE_LAYER, id }, { visited });
    }
  } catch (error) {}


  return visited;
}
