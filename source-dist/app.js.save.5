function afterSourceSettles(sourceId, callback, fallbackDelay = 8000) {
  let completed = false;
  let fallbackTimer = null;

  const finish = () => {
    if (completed) return;
    completed = true;
    map.off('sourcedata', onSourceData);
    window.clearTimeout(fallbackTimer);
    callback();
  };

  const onSourceData = (event) => {
    if (event.sourceId === sourceId && event.isSourceLoaded) finish();
  };

  if (map.isSourceLoaded(sourceId)) {
    finish();
    return;
  }

  map.on('sourcedata', onSourceData);
  fallbackTimer = window.setTimeout(finish, fallbackDelay);
}

function addSurfaceManagementMilitaryPattern() {
  const size = 16;
  const data = new Uint8Array(size * size * 4);
  for (let y = 0; y < size; y += 1) {
    for (let x = 0; x < size; x += 1) {
      // Two-pixel diagonal red slashes, repeated as a transparent tile.
      if ((x + y) % 8 < 2) {
        const offset = (y * size + x) * 4;
        data[offset] = 132;
        data[offset + 1] = 18;
        data[offset + 2] = 15;
        data[offset + 3] = 225;
      }
    }
  }
  if (!map.hasImage('surface-management-military-slashes')) {
    map.addImage('surface-management-military-slashes', { width: size, height: size, data });
  }
}

map.once('style.load', () => {
  addSurfaceManagementMilitaryPattern();
  requestAnimationFrame(() => map.resize());
  window.setTimeout(() => map.resize(), 250);
  const enableTerrain = () => {
    if (!terrainEnabled) return;
    map.setTerrain({ source: 'terrain', exaggeration: 1.15 });
    syncTwoDHillshade();
    map.easeTo({
      pitch: DEVICE.targetPitch,
      bearing: DEVICE.targetBearing,
      duration: DEVICE.initialTerrainTransition,
      easing: (progress) => progress * progress * (3 - 2 * progress),
      essential: false
    });
  };

  // Give imagery a head start, then load roads and finally terrain. Fallbacks
  // keep startup progressing if a remote source is slow or unavailable.
  syncTwoDHillshade();
  syncRoadView();

  // Apply the current visibility state of all zoom-dependent overlays
  // immediately on initial load instead of waiting for the first zoom event.
  syncZoomPresentation();


  // Start tile-backed research overlays immediately.
  // PMTiles/PBF requests can load in parallel with the base imagery.
  setMiningWithdrawalsVisible(miningWithdrawalsEnabled);
  setHistoricMinesVisible(historicMinesEnabled);

  let roadsStarted = false;
  const startRoads = () => {
    if (roadsStarted) return;
    roadsStarted = true;
    map.off('load', startRoads);
    window.clearTimeout(roadStartTimer);
    startupRoadsReady = true;
    syncRoadView();
    if (!roadRenderingEnabled) {
      enableTerrain();
      return;
    }
    requestAnimationFrame(() => afterSourceSettles('roads', enableTerrain, 8000));
  };
  const roadStartTimer = window.setTimeout(startRoads, 4000);
  map.once('load', startRoads);
});

