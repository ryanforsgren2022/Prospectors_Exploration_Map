}));


// AEM_EDGE_LAYOUT_V1: road-only density control.
const aemDensitySlider = document.getElementById('aemRoadDensity');
const aemDensityOutput = document.getElementById('aemRoadDensityValue');
const aemOriginalRoadFilters = new Map();

function aemUpdateRoadDensity() {
  if (!map.isStyleLoaded()) return;
  const value = Number(aemDensitySlider.value);
  const classes = ['motorway', 'motorway_link',
    'trunk', 'trunk_link'];
  if (value >= 20) classes.push('primary', 'primary_link');
  if (value >= 40) classes.push('secondary', 'secondary_link');
  if (value >= 55) classes.push('tertiary', 'tertiary_link');
  if (value >= 70) classes.push('residential', 'unclassified',
    'living_street');
  if (value >= 85) classes.push('service', 'track',
    'path', 'footway', 'cycleway');

  for (const layer of map.getStyle().layers || []) {
    if (layer.source !== 'roads' ||
        layer['source-layer'] !== 'roads' ||
        !map.getLayer(layer.id)) continue;

    if (!aemOriginalRoadFilters.has(layer.id)) {
      aemOriginalRoadFilters.set(
        layer.id, map.getFilter(layer.id) || true);
    }
    const original = aemOriginalRoadFilters.get(layer.id);
    const selected = ['in', ['get', 'highway'],
      ['literal', classes]];
    map.setFilter(layer.id, ['all', original, selected]);
  }
}

aemDensitySlider.addEventListener('input', () => {
  aemDensityOutput.textContent = aemDensitySlider.value + '%';
  aemUpdateRoadDensity();
});

map.on('style.load', () => {
  aemOriginalRoadFilters.clear();
  map.once('idle', aemUpdateRoadDensity);
});

const toolbarMenus = [...document.querySelectorAll('.toolbar-menu')];
toolbarMenus.forEach((menu) => {
  menu.addEventListener('toggle', () => {
    if (!menu.open) return;

    toolbarMenus.forEach((otherMenu) => {
      if (otherMenu === menu) return;

      // Preserve the parent Layers panel and its nested menus.
      if (menu.contains(otherMenu) ||
          otherMenu.contains(menu)) return;

      // Never close nested categories while using Layers.
      if (menu.closest('#aemLayersPanel') ||
          otherMenu.closest('#aemLayersPanel')) return;

      otherMenu.open = false;
    });
  });
});

const accountEmail = document.querySelector('#accountEmail');
const accountStatus = document.querySelector('#accountStatus');
const signOutButton = document.querySelector('#signOutButton');

function showAccountStatus(message = '') {
  accountStatus.textContent = message;
  accountStatus.hidden = !message;
}

async function initializeAccountControls() {
  try {
    const response = await fetch('/api/auth/session', {
      method: 'GET',
      credentials: 'same-origin',
      headers: { Accept: 'application/json' }
    });

    if (!response.ok) {
      accountEmail.textContent = 'Session expired';
      signOutButton.disabled = true;
      showAccountStatus('Please sign in again.');
      return;
    }

    const session = await response.json();

    accountEmail.textContent =
      session?.user?.email ||
      session?.email ||
      'Signed in';

    signOutButton.disabled = false;
    showAccountStatus('');
  } catch {
    accountEmail.textContent = 'Account unavailable';
    signOutButton.disabled = true;
    showAccountStatus('Refresh the page to reload account controls.');
  }
}

signOutButton.addEventListener('click', async () => {
  signOutButton.disabled = true;
  showAccountStatus('Signing out…');

  try {
    const response = await fetch('/api/auth/logout', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { Accept: 'application/json' }
    });

    if (!response.ok) {
      throw new Error('Sign out failed');
    }

    window.location.replace('https://americanexplorationmaps.com/');
  } catch {
    signOutButton.disabled = false;
    showAccountStatus('Sign out failed. Please try again.');
  }
});

window.addEventListener('load', initializeAccountControls, { once: true });

const gpsTrackingButton = document.querySelector('#gpsTrackingButton');
const gpsTrackingStatus = document.querySelector('#gpsTrackingStatus');
const dropPinButton = document.querySelector('#dropPinButton');
const dropPinStatus = document.querySelector('#dropPinStatus');
let gpsWatchId = null;
let gpsMarker = null;

function setDropPinMode(enabled) {
  dropPinMode = enabled;
  dropPinButton.setAttribute('aria-pressed', String(enabled));
  dropPinButton.classList.toggle('is-placing', enabled);
  dropPinButton.textContent = enabled ? 'Tap a spot on the map' : 'Drop & save pin';
  dropPinStatus.textContent = enabled ? 'Tap the exact spot to save' : 'Tap this, then tap the map';
  map.getCanvas().style.cursor = enabled ? 'crosshair' : '';
}

dropPinButton.addEventListener('click', () => setDropPinMode(!dropPinMode));

function stopGpsTracking(status = 'GPS off') {
  if (gpsWatchId !== null) navigator.geolocation?.clearWatch(gpsWatchId);
  gpsWatchId = null;
  gpsTrackingButton.textContent = 'Start GPS tracking';
  gpsTrackingButton.classList.remove('is-tracking');
  gpsTrackingButton.setAttribute('aria-pressed', 'false');
  gpsTrackingStatus.textContent = status;
}

function updateGpsPosition(position) {
  const { longitude, latitude, accuracy } = position.coords;
  if (!gpsMarker) {
    const element = document.createElement('div');
    element.className = 'gps-marker';
    element.setAttribute('aria-label', 'Your current location');
    gpsMarker = new maplibregl.Marker({ element, rotationAlignment: 'map' }).setLngLat([longitude, latitude]).addTo(map);
  } else {
    gpsMarker.setLngLat([longitude, latitude]);
  }
  gpsTrackingStatus.textContent = `Tracking ±${Math.round(accuracy)} m`;
}

gpsTrackingButton.addEventListener('click', () => {
  if (gpsWatchId !== null) {
    stopGpsTracking();
    return;
  }
  if (!navigator.geolocation) {
    gpsTrackingStatus.textContent = 'GPS unavailable';
    return;
  }
  gpsTrackingStatus.textContent = 'Locating…';
  gpsTrackingButton.textContent = 'Stop GPS tracking';
  gpsTrackingButton.classList.add('is-tracking');
  gpsTrackingButton.setAttribute('aria-pressed', 'true');
  gpsWatchId = navigator.geolocation.watchPosition(
    updateGpsPosition,
    (error) => {
      const status = error.code === error.PERMISSION_DENIED ? 'GPS permission denied' : 'GPS unavailable';
      stopGpsTracking(status);
    },
    { enableHighAccuracy: true, maximumAge: 5000, timeout: 15000 }
  );
});

const mapSearchForm = document.querySelector('#mapSearchForm');
const mapSearchInput = document.querySelector('#mapSearch');
const mapSearchStatus = document.querySelector('#mapSearchStatus');
let searchMarker = null;

function setSearchStatus(message, state = '') {
  mapSearchStatus.textContent = message;
  mapSearchStatus.className = `map-search__status${state ? ` ${state}` : ''}`;
}

function parseCoordinates(text) {
  const match = text.match(/^\s*(-?\d{1,3}(?:\.\d+)?)\s*[, ]\s*(-?\d{1,3}(?:\.\d+)?)\s*$/);
  if (!match) return null;
  const first = Number(match[1]);
  const second = Number(match[2]);
  const latitude = Math.abs(first) > 90 && Math.abs(second) <= 90 ? second : first;
  const longitude = Math.abs(first) > 90 && Math.abs(second) <= 90 ? first : second;
  return Math.abs(latitude) <= 90 && Math.abs(longitude) <= 180 ? { latitude, longitude } : null;
}

function parsePlss(text) {
  const compact = text.toUpperCase().replaceAll(',', ' ').replace(/\s+/g, ' ').trim();
  const match = compact.match(/(?:^|\s)T(?:OWNSHIP)?\s*(\d{1,3})\s*([NS])\s+R(?:ANGE)?\s*(\d{1,3})\s*([EW])(?:\s+(?:GSRM|G&SRM|GILA(?:\s+AND)?\s+SALT\s+RIVER(?:\s+MERIDIAN)?))?(?:\s+(?:S(?:EC(?:TION)?)?\s*)?(\d{1,2}))?\s*$/);
  if (!match) return null;
  return { township: Number(match[1]), townshipDirection: match[2], range: Number(match[3]), rangeDirection: match[4], section: match[5] ? Number(match[5]) : null };
}

function featureBounds(feature) {
  const bounds = new maplibregl.LngLatBounds();
  const visit = (coordinates) => {
    if (!Array.isArray(coordinates)) return;
    if (typeof coordinates[0] === 'number' && typeof coordinates[1] === 'number') bounds.extend(coordinates);
    else coordinates.forEach(visit);
  };
  visit(feature?.geometry?.coordinates);
  return bounds.isEmpty() ? null : bounds;
}

function makeSearchPopup(label, details = null, lngLat = null) {
  const content = document.createElement('div');
  const title = document.createElement('strong');
  title.textContent = label;
  content.append(title);
  if (details?.apn) {
    const apn = document.createElement('div');
    apn.textContent = `APN: ${details.apn}`;
    content.append(apn);
  }
  if (details?.address) {
    const address = document.createElement('div');
    address.textContent = details.address;
    content.append(address);
  }
  if (details?.assessorUrl) {
    const link = document.createElement('a');
    link.href = details.assessorUrl;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.textContent = `Open ${details.countyName} County Assessor`;
    link.style.display = 'block';
    link.style.marginTop = '6px';
    content.append(link);
  }
  if (lngLat) {
    const save = document.createElement('button');
    save.type = 'button';
    save.textContent = 'Save location';
    save.style.display = 'block';
    save.style.width = '100%';
    save.style.marginTop = '8px';
    save.addEventListener('click', () => openSaveLocationForm({ lng: lngLat.lng, lat: lngLat.lat, name: label }));
    content.append(save);
  }
  return content;
}

function showSearchPin(lngLat, label, bounds = null, details = null) {
  document.getElementById('aem-navigate-result')?.remove();

  const button = document.createElement('button');
  button.id = 'aem-navigate-result';
  button.type = 'button';
  button.textContent = 'Navigate to Result';

  button.addEventListener('click', () => {
    button.remove();

    const center = Array.isArray(lngLat)
      ? lngLat
      : [lngLat.lng, lngLat.lat];

    if (!center.every(Number.isFinite)) {
      setSearchStatus('Invalid result coordinates.', 'error');
      return;
    }

    if (!searchMarker) {
      const element = document.createElement('div');
      element.className = 'search-marker';
      element.innerHTML = '<span>⌖</span>';
      searchMarker = new maplibregl.Marker({
        element, anchor: 'bottom'
      }).setLngLat(center).addTo(map);
    } else {
      searchMarker.setLngLat(center);
    }

    const point = { lng: center[0], lat: center[1] };
    searchMarker.setPopup(
      new maplibregl.Popup({
        offset: 20, closeButton: false
      }).setDOMContent(makeSearchPopup(label, details, point))
    );
    searchMarker.togglePopup();

    aemSearchLastMapState = undefined;

    if (bounds) {
      aemSearchNavigating = true;
      map.once('moveend', () => {
        aemSearchNavigating = false;
      });
      map.fitBounds(bounds, {
        padding: 72,
        maxZoom: 14,
        duration: 650,
        essential: false
      });
    } else {
      aemNavigateToSearchResult(
        center, Math.max(map.getZoom(), 14)
      );
    }
  });

  mapSearchForm.appendChild(button);
  mapSearchForm.addEventListener(
    'submit', () => button.remove(), { once: true }
  );
}

function normalizeEsriGeometry(geometry = {}) {

  if (
    Number.isFinite(geometry.x)
    &&
    Number.isFinite(geometry.y)
  ) {

    return {
      type: 'Point',

      coordinates: [
        geometry.x,
        geometry.y
      ]
    };
  }

  if (
    Array.isArray(
      geometry.paths
    )
  ) {

    return (
      geometry.paths.length === 1

        ? {
            type: 'LineString',

            coordinates:
              geometry.paths[0]
          }

        : {
            type: 'MultiLineString',

            coordinates:
              geometry.paths
          }
    );
  }

  if (
    Array.isArray(
      geometry.rings
    )
  ) {

    return {
      type: 'Polygon',

      coordinates:
        geometry.rings
    };
  }

  if (
    Array.isArray(
      geometry.points
    )
  ) {

    return {
      type: 'MultiPoint',

      coordinates:
        geometry.points
    };
  }

  return null;
}

function normalizeEsriFeature(feature) {

  if (!feature)
    return null;

  return {
    type: 'Feature',

    properties:
      feature.attributes
      || {},

    geometry:
      normalizeEsriGeometry(
        feature.geometry
        || {}
      )
  };
}

async function queryFirstFeature(query, where, geometry = null) {
  const params = new URLSearchParams({
    where,
    outFields: '*',
    returnGeometry: 'true',
    outSR: '4326',
    resultRecordCount: '1',
    f: 'json'
  });

  if (geometry) {
    const bounds =
      featureBounds(
        geometry
      );

    if (bounds) {

      params.set(
        'geometry',
        `${bounds.getWest()},${bounds.getSouth()},${bounds.getEast()},${bounds.getNorth()}`
      );

      params.set(
        'geometryType',
        'esriGeometryEnvelope'
      );

      params.set(
        'inSR',
        '4326'
      );

      params.set(
        'spatialRel',
        'esriSpatialRelIntersects'
      );
    }
  }

  const response =
    await fetch(
      `${query}?${params}`
    );

  if (!response.ok) {
    throw new Error(
      'Search service is unavailable.'
    );
  }

  const data =
    await response.json();

  return normalizeEsriFeature(
    data?.features?.[0]
    || null
  );
}

async function searchPlss(plss) {
  const number = (value) => String(value);
  const padded = (value) => String(value).padStart(3, '0');
  const townshipWhere = `(TWNSHPNO = '${number(plss.township)}' OR TWNSHPNO = '${padded(plss.township)}') AND TWNSHPDIR = '${plss.townshipDirection}' AND (RANGENO = '${number(plss.range)}' OR RANGENO = '${padded(plss.range)}') AND RANGEDIR = '${plss.rangeDirection}'`;
  const township = await queryFirstFeature(PLSS_TOWNSHIPS_QUERY, townshipWhere);
  if (!township) throw new Error('That township and range was not found.');
  if (!plss.section) return { feature: township, label: `T${plss.township}${plss.townshipDirection} R${plss.range}${plss.rangeDirection}` };
  const sectionNumber = String(plss.section);
  const section = await queryFirstFeature(PLSS_SECTIONS_QUERY, `(FRSTDIVNO = '${sectionNumber}' OR FRSTDIVNO = '${sectionNumber.padStart(3, '0')}')`, township);
  if (!section) throw new Error('That section was not found in the selected township.');
  return { feature: section, label: `T${plss.township}${plss.townshipDirection} R${plss.range}${plss.rangeDirection} Section ${plss.section}` };
}

async function searchAddress(value) {
  const params = new URLSearchParams({
    SingleLine: value,
    countryCode: 'USA',
    maxLocations: '5',
    outFields: 'Match_addr,LongLabel,RegionAbbr',
    f: 'json'
  });

  const response = await fetch(
    `${ARCGIS_GEOCODE_QUERY}?${params}`
  );

  if (!response.ok) {
    throw new Error('Address search is unavailable.');
  }

  const data = await response.json();

  if (data.error) {
    throw new Error(data.error.message || 'Geocoder error.');
  }

  // Accept results from any US state.
  return data.candidates?.[0] || null;
}

function sqlText(value) {
  return String(value).replaceAll("'", "''");
}

async function searchParcel(value) {
  return queryFirstFeature(PROPERTY_PARCELS_QUERY, `AZ_APN = '${sqlText(value)}'`);
}

async function countyAtPoint(lngLat) {
  const counties = await queryResearchLocation(COUNTIES_QUERY, { lng: lngLat.lng, lat: lngLat.lat }, 'BASENAME');
  return counties[0]?.attributes?.BASENAME || null;
}

async function searchClaim(value, partial = false) {
  const cleaned = sqlText(value.replace(/\s+/g, '').toUpperCase());
  const where = partial
    ? `(UPPER(CSE_NR) LIKE '%${cleaned}%' OR UPPER(CSE_NAME) LIKE '%${sqlText(value).toUpperCase()}%')`
    : `(UPPER(CSE_NR) = '${cleaned}' OR UPPER(CSE_NAME) = '${sqlText(value).toUpperCase()}')`;
  return queryFirstFeature(NOT_CLOSED_CLAIMS_QUERY, where);
}

function showFeatureSearchResult(feature, label) {
  const bounds = featureBounds(feature);
  if (!bounds) throw new Error('That record does not include a map boundary.');
  showSearchPin(bounds.getCenter(), label, bounds);
}

async function showParcelSearchResult(feature, label) {
  const bounds = featureBounds(feature);
  if (!bounds) throw new Error('That parcel record does not include a map boundary.');
  const center = bounds.getCenter();
  let countyName = null;
  try { countyName = await countyAtPoint(center); } catch (error) { console.warn('County lookup unavailable:', error.message); }
  const properties = feature.properties || {};
  showSearchPin(center, label, bounds, {
    apn: properties.AZ_APN,
    address: properties.AZ_Address || properties.AZ_PlaceName,
    countyName,
    assessorUrl: countyName ? COUNTY_ASSESSORS[countyName] : null
  });
}

async function showPointSearchResult(lngLat, label, bounds = null, isCurrent = () => true) {
  const point = { lng: lngLat[0], lat: lngLat[1] };

  // Existing Arizona parcel enrichment applies only in Arizona.
  // Other states must not depend on Arizona's parcel service.
  const inArizona =
    point.lng >= -114.95 && point.lng <= -108.85 &&
    point.lat >= 31.2 && point.lat <= 37.1;

  const [parcelResult, countyResult] = await Promise.allSettled([
    aemParcelAtPoint(point),
    inArizona ? countyAtPoint(point) : Promise.resolve(null)
  ]);
  if (!isCurrent()) return;
  const parcel = parcelResult.status === 'fulfilled' ? parcelResult.value : null;
  const countyName = countyResult.status === 'fulfilled' ? countyResult.value : null;
  const properties = parcel?.properties || {};
  showSearchPin(lngLat, label, bounds, parcel ? {
    apn: properties.AZ_APN,
    address: properties.AZ_Address || properties.AZ_PlaceName,
    countyName,
    assessorUrl: countyName ? COUNTY_ASSESSORS[countyName] : null
  } : null);
}

/* AEM MULTISTATE SEARCH ROUTING V1 */
const AEM_SEARCH_API =
  'https://tiles.americanexplorationmaps.com/api/search';

function aemSearchState() {
  const center = map.getCenter();

  for (const [code, state] of prospectorStateRegistry) {
    const b = state?.bounds;
    if (
      code !== 'az' &&
      Array.isArray(b) && b.length === 4 &&
      center.lng >= b[0] && center.lng <= b[2] &&
      center.lat >= b[1] && center.lat <= b[3]
    ) {
      return code;
    }
  }

  // Preserve the legacy Arizona search behavior.
  if (
    center.lng >= -114.95 && center.lng <= -108.85 &&
    center.lat >= 31.2 && center.lat <= 37.1
  ) return 'az';

  return null;
}

function aemParseStateSearch(raw) {
  const names = {
    AZ: 'az', ARIZONA: 'az',
    CA: 'ca', CALIFORNIA: 'ca',
    CO: 'co', COLORADO: 'co',
    ID: 'id', IDAHO: 'id',
    MT: 'mt', MONTANA: 'mt',
    NV: 'nv', NEVADA: 'nv',
    NM: 'nm', 'NEW MEXICO': 'nm',
    OR: 'or', OREGON: 'or',
    UT: 'ut', UTAH: 'ut',
    WA: 'wa', WASHINGTON: 'wa',
    WY: 'wy', WYOMING: 'wy'
  };

  const match = raw.match(
    /^(NEW MEXICO|ARIZONA|CALIFORNIA|COLORADO|IDAHO|MONTANA|NEVADA|OREGON|UTAH|WASHINGTON|WYOMING|AZ|CA|CO|ID|MT|NV|NM|OR|UT|WA|WY)\s*[:,-]?\s+(.+)$/i
  );

  if (!match) {
    return { state: aemSearchState(), value: raw };
  }

  return {
    state: names[match[1].toUpperCase()],
    value: match[2].trim()
  };
}

async function aemSearchApi(state, type, params) {
  const url = new URL(
    `${AEM_SEARCH_API}/${state}/${type}`
  );

  for (const [key, value] of Object.entries(params)) {
    if (value != null) {
      url.searchParams.set(key, String(value));
    }
  }

  const response = await fetch(url);

  if (response.status === 404) {
    throw new Error('State search service unavailable (' +
      response.status + ').');
  }

  if (!response.ok) {
    throw new Error('State search service unavailable (' +
      response.status + ').');
  }

  const data = await response.json();
  if (Array.isArray(data.features) && data.features.length === 0) {
    throw new Error('No matching record found in ' +
      state.toUpperCase() + '.');
  }
  const feature = data.features?.[0];

  if (!feature?.geometry) {
    throw new Error('Search returned no usable map geometry.');
  }

  return feature;
}

async function aemSearchPlss(state, plss) {
  if (!state) {
    throw new Error('Select a state before searching PLSS.');
  }

  if (state === 'az') return searchPlss(plss);

  const feature = await aemSearchApi(state, 'plss', {
    township: plss.township,
    township_dir: plss.townshipDirection,
    range_num: plss.range,
    range_dir: plss.rangeDirection,
    section: plss.section
  });

  return {
    feature,
    label: `${state.toUpperCase()} T${plss.township}${plss.townshipDirection}` +
      ` R${plss.range}${plss.rangeDirection}` +
      (plss.section ? ` Section ${plss.section}` : '')
  };
}

async function aemSearchClaim(state, value) {
  if (!state) {
    throw new Error('Select a state before searching claims.');
  }

  if (state === 'az') return searchClaim(value);

  return aemSearchApi(state, 'claims', { value });
}

let aemSearchRequestId = 0;
let aemSearchLastMapState;
let aemSearchNavigating = false;

function aemNavigateToSearchResult(lngLat, zoom = 13) {
  if (!Array.isArray(lngLat) || lngLat.length !== 2 ||
      !lngLat.every(Number.isFinite)) {
    throw new Error('Invalid navigation coordinates.');
  }

  aemSearchNavigating = true;

  map.once('moveend', () => {
    aemSearchNavigating = false;
  });

  try {
    map.flyTo({ center: lngLat, zoom });
  } catch (error) {
    aemSearchNavigating = false;
    throw error;
  }
}


mapSearchForm.addEventListener('submit', async (event) => {
  event.preventDefault();
  const requestId = ++aemSearchRequestId;
  aemSearchLastMapState = aemSearchState();
  const isCurrent = () => requestId === aemSearchRequestId;
  const raw = mapSearchInput.value.trim();
  if (!raw) return setSearchStatus('Enter an address, coordinates, or PLSS reference.', 'error');
  mapSearchInput.disabled = true;
  setSearchStatus('Searching…');
  try {
    const coordinates = parseCoordinates(raw);
    if (coordinates) {
      await showPointSearchResult([coordinates.longitude, coordinates.latitude], `${coordinates.latitude.toFixed(5)}, ${coordinates.longitude.toFixed(5)}`, null, isCurrent);
      if (!isCurrent()) return;
      setSearchStatus('Result ready. Choose Navigate to Result.', 'success');
      return;
    }
    const searchContext = aemParseStateSearch(raw);
    const state = searchContext.state;
    const searchValue = searchContext.value;
    const plss = parsePlss(searchValue);
    if (plss) {
      const result = await aemSearchPlss(state, plss);
      if (!isCurrent()) return;
      const bounds = featureBounds(result.feature);
      const center = bounds.getCenter();
      await showPointSearchResult([center.lng, center.lat], result.label, bounds, isCurrent);
      if (!isCurrent()) return;
      setSearchStatus('Result ready. Choose Navigate to Result.', 'success');
      return;
    }
    const apnPrefix = searchValue.match(/^(?:APN|PARCEL)\s*[:#-]?\s*(.+)$/i);
    if (apnPrefix) {
      const value = apnPrefix[1].trim();
      if (state && state !== 'az') {
        const feature = await aemSearchApi(state, 'parcels', { value });
        if (!isCurrent()) return;
        const bounds = featureBounds(feature);
        if (!bounds) throw new Error('Parcel geometry unavailable.');
        const details = feature.properties || {};
        const parcelId = details.APN || details.parcel_id || value;
        showSearchPin(
          bounds.getCenter(),
          `${state.toUpperCase()} Parcel ${parcelId}`,
          bounds,
          {
            apn: parcelId,
            address: details.situsAdd || details.SiteAddress || '',
            countyName: details.countyName || details.County || '',
            assessorUrl: details.URL || details.Website || null
          }
        );
      } else if (state === 'az') {
        const feature = await searchParcel(value);
        if (!isCurrent()) return;
        if (!feature) throw new Error('That parcel APN was not found.');
        await showParcelSearchResult(feature, `Parcel ${feature.properties?.AZ_APN || value}`);
      } else {
        throw new Error('Select a supported state for parcel search.');
      }
      if (!isCurrent()) return;
      setSearchStatus('Result ready. Choose Navigate to Result.', 'success');
      return;
    }
    const claimPrefix = searchValue.match(/^(?:CLAIM|BLM|CASE)\s*[:#-]?\s*(.+)$/i);
    const looksLikeClaimNumber = /^(?:AMC|AZA|AZAR|NMC|NVN|UMC|UTU)\s*\d+/i.test(searchValue);
    if (claimPrefix || looksLikeClaimNumber) {
      const value = claimPrefix?.[1] || searchValue;
      const feature = await aemSearchClaim(state, value);
      if (!isCurrent()) return;
      if (!feature) throw new Error('That BLM not-closed claim or case was not found.');
      showFeatureSearchResult(feature, `Claim ${feature.properties?.CSE_NAME || value}`);
      if (!isCurrent()) return;
      setSearchStatus('Result ready. Choose Navigate to Result.', 'success');
      return;
    }
    const address = await searchAddress(raw);
    if (!isCurrent()) return;
    if (!address?.location) throw new Error('No matching US address was found.');
    await showPointSearchResult([address.location.x, address.location.y], address.attributes?.LongLabel || address.address || raw, null, isCurrent);
    if (!isCurrent()) return;
    setSearchStatus('Result ready. Choose Navigate to Result.', 'success');
  } catch (error) {
    if (!isCurrent()) return;
    setSearchStatus(error.message || 'Search is temporarily unavailable.', 'error');
  } finally {
    if (isCurrent()) {
      mapSearchInput.disabled = false;
    }
  }
});

