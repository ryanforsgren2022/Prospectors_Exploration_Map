  // A deliberate hold keeps research available without interrupting a slow drag.
  researchLongPressTimer = window.setTimeout(() => openResearchLocation(location), 450);
});
['touchmove', 'touchend', 'touchcancel'].forEach((name) => map.on(name, () => {
