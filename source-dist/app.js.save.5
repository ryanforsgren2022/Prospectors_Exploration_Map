// AEM VM AUTO VECTOR LAYERS
// Shared renderer for published VM vector source layers.

const aemVMRegistry = new Map();
const aemVMHidden = new Set();

let aemVMControls = null;

const aemVMStyles = [
  {
    suffix: 'fill',
    type: 'fill',
    geometry: 'Polygon',
    paint: {
      'fill-color': '#7298b2',
      'fill-opacity': 0.22
    }
  },
  {
    suffix: 'line',
    type: 'line',
    geometry: 'LineString',
    paint: {
      'line-color': '#416782',
      'line-width': 1.5
    }
  },
  {
    suffix: 'point',
    type: 'circle',
    geometry: 'Point',
    paint: {
      'circle-color': '#bb8244',
      'circle-radius': 3.5,
      'circle-stroke-color': '#ffffff',
      'circle-stroke-width': 0.7
    }
  }
];

function aemVMSourceId(code, item) {
  return `aem-vm-${code}-${item.id}`;
}

function aemVMRemove(code, item) {
  const sourceId = aemVMSourceId(code, item);

  for (const style of aemVMStyles) {
    const id = `${sourceId}-${style.suffix}`;
    if (map.getLayer(id)) map.removeLayer(id);
  }

  if (map.getSource(sourceId)) {
    map.removeSource(sourceId);
  }
}

function aemVMSourceDefinition(item) {
  const source = {
    type: 'vector',
    minzoom: item.minzoom ?? 0,
    maxzoom: item.maxzoom ?? 18
  };

  const prefix =
    'https://tiles.americanexplorationmaps.com/api/vm-data/';

  if (
    Array.isArray(item.tiles) &&
    item.tiles.length &&
    item.tiles.every(url =>
      typeof url === 'string' &&
      url.startsWith(prefix)
    )
  ) {
    source.tiles = item.tiles;
    return source;
  }

  if (
    typeof item.url === 'string' &&
    item.url.startsWith('pmtiles://' + prefix)
  ) {
    source.url = item.url;
    return source;
  }

  return null;
}

// Render additional published dataset groups using the shared generic renderer.
// Known groups retain their normal controls and styling; unverified claims remain
// separately labelled rather than appearing under the non-closed claims control.
function discoverGenericVmLayers(state) {
  const layers = Array.isArray(state.autoLayers) ? [...state.autoLayers] : [];
  const known = new Set(PROSPECTOR_GROUP_NAMES);
  const accepted = prospectorVmDatasets(state);
  for (const [group, item] of Object.entries(state.datasets || {})) {
    if (!/^[A-Za-z][A-Za-z0-9]*$/.test(group) || !item || typeof item !== 'object') continue;
    if (group === 'historicMines' || group === 'claimsBlmLands' ||
        (known.has(group) && accepted[group])) continue;
    if (!item.sourceLayer || !aemVMSourceDefinition(item)) continue;
    layers.push({ ...item, id: `dataset_${group}`, name: group });
  }
  return layers;
}

function isGenericVmLayerId(id) {
  return /^auto_[a-f0-9]{16}$/.test(id || '') || /^dataset_[A-Za-z][A-Za-z0-9]*$/.test(id || '');
}

function syncDynamicVMMapLayers() {
  if (!map.getStyle()?.layers?.length) return;

  for (const [code, state] of aemVMRegistry) {
    const inView = prospectorsStateIntersectsView(
      state.bounds
    );

    if (inView || state.autoLayers.some(item => map.getSource(aemVMSourceId(code, item)))) {
      scheduleOffscreenEviction(`auto:${code}`, state.bounds, inView, () => {
        for (const item of aemVMRegistry.get(code)?.autoLayers || []) aemVMRemove(code, item);
      });
    }

    for (const item of state.autoLayers) {
      if (
        !isGenericVmLayerId(item.id) ||
        typeof item.sourceLayer !== 'string' ||
        !item.sourceLayer
      ) continue;

      const sourceId = aemVMSourceId(code, item);

      const visible =
        inView &&
        !aemVMHidden.has(code + '/' + item.id);

      if (visible && !map.getSource(sourceId)) {
        const definition =
          aemVMSourceDefinition(item);

        if (!definition) continue;

        try {
          map.addSource(sourceId, definition);
        } catch (error) {
          console.warn('VM source error:', error);
          continue;
        }
      }

      for (const style of aemVMStyles) {
        const id = `${sourceId}-${style.suffix}`;

        if (
          visible &&
          map.getSource(sourceId) &&
          !map.getLayer(id)
        ) {
          try {
            map.addLayer({
              id,
              type: style.type,
              source: sourceId,
              'source-layer': item.sourceLayer,
              filter: [
                '==',
                ['geometry-type'],
                style.geometry
              ],
              layout: {
                visibility: 'none'
              },
              paint: style.paint
            });
          } catch (error) {
            console.warn('VM layer error:', id, error);
          }
        }

        if (map.getLayer(id)) {
          map.setLayoutProperty(
            id,
            'visibility',
            visible ? 'visible' : 'none'
          );
        }
      }
    }
  }
}

function aemVMRenderControls() {
  const entries = [];

  for (const [code, state] of aemVMRegistry) {
    for (const item of state.autoLayers) {
      entries.push([code, item]);
    }
  }

  if (!entries.length) {
    if (aemVMControls) {
      aemVMControls.replaceChildren();
    }
    return;
  }

  if (!aemVMControls) {
    const wrapper = document.createElement('div');

    wrapper.className = 'maplibregl-ctrl';
    wrapper.style.cssText =
      'background:#fff;color:#222;padding:8px;' +
      'max-height:260px;max-width:230px;' +
      'overflow:auto;border-radius:4px;' +
      'box-shadow:0 1px 5px #0003;' +
      'font:12px sans-serif';

    const details = document.createElement('details');
    const summary = document.createElement('summary');
    const content = document.createElement('div');

    summary.textContent = 'VM data layers';

    details.append(summary, content);
    wrapper.appendChild(details);

    document.querySelector('#aemDynamicLayers').appendChild(wrapper);

    aemVMControls = content;
  }

  aemVMControls.replaceChildren();

  for (const [code, item] of entries) {
    const key = code + '/' + item.id;
    const label = document.createElement('label');
    const checkbox = document.createElement('input');

    label.style.cssText = 'display:block;padding:3px 0';
    checkbox.type = 'checkbox';
    checkbox.checked = !aemVMHidden.has(key);

    checkbox.addEventListener('change', () => {
      if (checkbox.checked) {
        aemVMHidden.delete(key);
      } else {
        aemVMHidden.add(key);
      }
      syncDynamicVMMapLayers();
    });

    label.append(
      checkbox,
      document.createTextNode(
        ` ${code.toUpperCase()} · ${item.name || item.sourceLayer}`
      )
    );

    aemVMControls.appendChild(label);
  }
}

async function refreshDynamicVMMapLayers(refresh = false) {
  try {
    const data = await loadStateDiscovery(refresh);

    const next = new Map();

    for (const [code, state] of Object.entries(data.states)) {
      if (
        !/^[a-z]{2}$/.test(code) ||
        !Array.isArray(state.bounds) ||
        state.bounds.length !== 4 ||
        !state.bounds.every(Number.isFinite)
      ) continue;

      next.set(code, {
        bounds: state.bounds,
        autoLayers: discoverGenericVmLayers(state).filter(
          item =>
            isGenericVmLayerId(item.id) &&
            typeof item.sourceLayer === 'string' &&
            aemVMSourceDefinition(item)
        )
      });
    }

    for (const [code, state] of aemVMRegistry) {
      const incoming = new Map(
        (next.get(code)?.autoLayers || [])
          .map(item => [item.id, item])
      );

      for (const item of state.autoLayers) {
        const replacement = incoming.get(item.id);

        if (
          !replacement ||
          JSON.stringify(replacement) !== JSON.stringify(item)
        ) {
          aemVMRemove(code, item);
        }
      }
    }

    aemVMRegistry.clear();

    for (const [code, state] of next) {
      aemVMRegistry.set(code, state);
    }

    syncDynamicVMMapLayers();
    aemVMRenderControls();

  } catch (error) {
    console.warn('Automatic VM discovery:', error);
  }
}

if (map.loaded()) {
  refreshDynamicVMMapLayers();
} else {
  map.once('style.load', () => refreshDynamicVMMapLayers());
}

// Refresh published automatic layers periodically while the page is visible.
// A longer interval also discovers newly published layers when none exist yet.
window.setInterval(() => {
  if (!document.hidden) void refreshDynamicVMMapLayers(true);
}, 300000);




// AEM CO NV PARCEL PIN DETAILS
function aemParcelPinDetails(properties = {}) {
  const state = typeof aemParcelState !== 'undefined'
    ? aemParcelState : 'az';

  const parcelId = state === 'co'
    ? properties.parcel_id
    : state === 'nv'
      ? (properties.APN || properties.parcel_id)
      : properties.AZ_APN;

  const link = state === 'co'
    ? properties.URL
    : state === 'nv'
      ? properties.Website
      : null;

  let recordUrl = null;
  try {
    const url = new URL(link);
    if (['https:', 'http:'].includes(url.protocol)) {
      recordUrl = url.href;
    }
  } catch (_) {}

  return {
    parcelId: parcelId || '',
    address: properties.situsAdd || properties.SiteAddress ||
      properties.AZ_Address || '',
    county: properties.countyName || properties.County || '',
    acreage: properties.landAcres ?? properties.Acres ?? '',
    owner: properties.owner || '',
    propertyRecordsUrl: recordUrl
  };
}


// AEM CO NV PARCEL LONG PRESS
function aemParcelAtPoint(point) {
  const state = typeof aemParcelState !== 'undefined'
    ? aemParcelState : 'az';

  if (state === 'az') return parcelAtPoint(point);
  if (state !== 'co' && state !== 'nv') return Promise.resolve(null);

  const pixel = map.project(point);
  const features = map.queryRenderedFeatures(pixel, {
    layers: ['property-parcels-fill']
  });

  const feature = features.find(f => f.properties);
  if (!feature) return Promise.resolve(null);

  const details = aemParcelPinDetails(feature.properties);

  return Promise.resolve({
    type: 'Feature',
    geometry: feature.geometry,
    properties: {
      ...feature.properties,
      AZ_APN: details.parcelId,
      AZ_Address: details.address,
      AZ_PlaceName: details.county,
      propertyRecordsUrl: details.propertyRecordsUrl
    }
  });
}

// AEM_LAYOUT_PIN_V13
(function () {
  let selectedPin = null;
  const originalResearch = openResearchLocation;

  openResearchLocation = function (lngLat) {
    const lng = Number(lngLat?.lng);
    const lat = Number(lngLat?.lat);

    if (Number.isFinite(lng) && Number.isFinite(lat)) {
      if (!selectedPin) {
        const element = document.createElement('div');
        element.className = 'aem-selected-pin-v13';

        selectedPin = new maplibregl.Marker({
          element,
          anchor: 'bottom'
        }).setLngLat([lng, lat]).addTo(map);
      } else {
        selectedPin.setLngLat([lng, lat]);
      }
    }

    return originalResearch(lngLat);
  };

  document.getElementById('researchLocationClose')
    ?.addEventListener('click', () => {
      selectedPin?.remove();
      selectedPin = null;
    });

  function alignZoom() {
    const attribution = document.querySelector(
      '.maplibregl-ctrl-attrib'
    );
    const bottom = attribution
      ? attribution.getBoundingClientRect().bottom
      : 42;

    document.documentElement.style.setProperty(
      '--aem-credit-bottom',
      Math.ceil(Math.max(32, bottom) + 8) + 'px'
    );
  }

  map.on('load', alignZoom);
  window.addEventListener('resize', alignZoom);

  if ('ResizeObserver' in window) {
    const attribution = document.querySelector(
      '.maplibregl-ctrl-attrib'
    );
    if (attribution) {
      new ResizeObserver(alignZoom).observe(attribution);
    }
  }

  requestAnimationFrame(alignZoom);
})();
