function addSavedLocationMarker(location) {
  const existing = savedLocationMarkers.get(location.id);
  if (existing) existing.remove();
  const element = document.createElement('div');
  element.className = 'saved-location-marker';
  const marker = new maplibregl.Marker({ element, anchor: 'bottom' })
    .setLngLat([location.lng, location.lat])
    .setPopup(new maplibregl.Popup({ offset: 16 }).setDOMContent(makeSavedLocationPopup(location)))
    .addTo(map);
  savedLocationMarkers.set(location.id, marker);
}

