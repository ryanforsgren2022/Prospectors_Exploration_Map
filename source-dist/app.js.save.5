/* PROSPECTORS SHARED STATE LOADER v2 — LAZY PMTILES */


const prospectorStateRegistry = new Map();
let stateDiscoveryPromise = null;

function loadStateDiscovery(refresh = false) {
  if (!stateDiscoveryPromise || refresh) {
    const request = fetch(
      'https://tiles.americanexplorationmaps.com/api/states/discover-v2',
      { cache: 'no-store' }
    ).then(async (response) => {
      if (!response.ok) throw new Error(`State discovery HTTP ${response.status}`);
      const data = await response.json();
      if (data.schemaVersion !== 2 || !data.states || typeof data.states !== 'object') {
        throw new Error('Invalid state discovery response');
      }
      return data;
    });
    stateDiscoveryPromise = request;
    request.catch(() => {
      if (stateDiscoveryPromise === request) stateDiscoveryPromise = null;
    });
  }
  return stateDiscoveryPromise;
}

/*
 * A state can be initialized without opening any of its large PMTiles
 * archives. Individual dataset groups are attached only when needed.
 */
const initializedProspectorStates = new Set();
const readyProspectorGroups = new Set();
const prospectorStateLayers = new Map();
const prospectorLayerListeners = new Map();
const offscreenEvictionTimers = new Map();
const OFFSCREEN_EVICTION_DELAY = 30000;

function scheduleOffscreenEviction(key, bounds, inView, evict) {
  const pending = offscreenEvictionTimers.get(key);
  if (inView) {
    if (pending !== undefined) window.clearTimeout(pending);
    offscreenEvictionTimers.delete(key);
    return;
  }
  if (pending !== undefined) return;
  const timer = window.setTimeout(() => {
    offscreenEvictionTimers.delete(key);
    if (!prospectorsStateIntersectsView(bounds)) evict();
  }, OFFSCREEN_EVICTION_DELAY);
  offscreenEvictionTimers.set(key, timer);
}

function evictProspectorOverlays(stateCode) {
  const groups = prospectorStateLayers.get(stateCode);
  if (!groups) return;
  const sources = new Set();
  for (const group of PROSPECTOR_GROUP_NAMES) {
    if (group === 'boundary') continue;
    for (const id of groups[group]) {
      const layer = map.getLayer(id);
      if (layer?.source) sources.add(layer.source);
      for (const [event, listener] of prospectorLayerListeners.get(id) || []) {
        map.off(event, id, listener);
      }
      prospectorLayerListeners.delete(id);
      if (layer) map.removeLayer(id);
    }
    groups[group] = [];
    readyProspectorGroups.delete(`${stateCode}:${group}`);
  }
  for (const source of sources) {
    if (map.getSource(source)) map.removeSource(source);
  }
}

const PROSPECTOR_EXTRA_PLSS = Object.freeze({
  plssGovernmentLots: { suffix: 'government-lots', point: false },
  plssSpecialSurveys: { suffix: 'special-surveys', point: false },
  plssQuarterSections: { suffix: 'quarter-sections', point: false },
  plssQuarterQuarterSections: { suffix: 'quarter-quarter-sections', point: false },
  plssSurveyPoints: { suffix: 'survey-points', point: true },
  plssIntersected: { suffix: 'intersected', point: false },
  plssSecondDivision: { suffix: 'second-division', point: false }
});

const PROSPECTOR_GROUP_NAMES = Object.freeze([
  'boundary',
  'surfaceManagement',
  'claims',
  'withdrawals',
  'plssTownships',
  'plssSections',
  'historicMines',
  ...Object.keys(PROSPECTOR_EXTRA_PLSS),
  'parcels'
]);

function prospectorsStateIntersectsView(stateBounds) {
  if (!Array.isArray(stateBounds) || stateBounds.length !== 4) {
    return false;
  }

  const view = map.getBounds();
  const [west, south, east, north] = stateBounds;

  return !(
    view.getEast() < west ||
    view.getWest() > east ||
    view.getNorth() < south ||
    view.getSouth() > north
  );
}

const PROSPECTOR_R2_BASE_URL = 'https://data.americanexplorationmaps.com/prospectors/';
const WESTERN_PROSPECTOR_STATES = new Set(['az', 'ca', 'co', 'id', 'mt', 'nm', 'nv', 'or', 'ut', 'wa', 'wy']);

const CA_HISTORIC_MINES_URL =
  'https://data.americanexplorationmaps.com/prospectors/ca/historic-mines.pmtiles';

function prospectorsDatasetUrl(state, dataset) {
  // Archive fallback is VM-only. Discovery owns the exact object path.
  const raw = dataset?.path || dataset?.file;
  if (typeof raw !== 'string' || !raw || !state.baseUrl) return null;
  try {
    const base = state.baseUrl.endsWith('/') ? state.baseUrl : state.baseUrl + '/';
    const url = new URL(raw, base);
    return url.origin === 'https://tiles.americanexplorationmaps.com' &&
      url.pathname.endsWith('.pmtiles') ? 'pmtiles://' + url.href : null;
  } catch {
    return null;
  }
}

function prospectorVmDatasets(incoming) {
  // Retain VM routes, PLSS sublayers, and claims semantics exactly as discovered.
  const datasets = { ...(incoming.datasets || {}) };
  // The backend owns normalization, unknown-value auditing and per-feature exclusion.
  // Never accept an Active-only or unverified legacy claims source under either control.
  for (const group of ['claims']) {
    const dataset = datasets[group];
    if (dataset && (dataset.semantics !== 'notClosed' ||
        dataset.classificationFilter?.rule !== 'notClosed' ||
        dataset.classificationFilter?.unknownPolicy !== 'report-separately')) delete datasets[group];
  }
  delete datasets.claimsBlmLands;
  delete datasets.historicMines;
  return datasets;
}

async function prepareProspectorDatasets(stateCode, incoming) {
  const datasets = prospectorVmDatasets(incoming);
  if (!WESTERN_PROSPECTOR_STATES.has(stateCode)) return datasets;
  const url = `${PROSPECTOR_R2_BASE_URL}${stateCode}/historic-mines.pmtiles`;
  try {
    const archive = new pmtiles.PMTiles(url);
    const [header, metadata] = await Promise.all([archive.getHeader(), archive.getMetadata()]);
    const layers = metadata.vector_layers || [];
    const discoveredLayer =
    layers.find(item =>
      item.id === incoming.datasets?.historicMines?.sourceLayer &&
      !/(?:^|_)polygons?$/i.test(item.id)
    )?.id ||
    layers.find(item =>
      /historic.*min|mine/i.test(item.id) &&
      !/(?:^|_)polygons?$/i.test(item.id)
    )?.id ||
    layers.find(item =>
      !/(?:^|_)polygons?$/i.test(item.id)
    )?.id;
    const pointLayers = layers.filter(item => /(?:^|_)points?$/i.test(item.id || ''));
    const layer = layers.find(item => item.id === discoveredLayer && !/(?:^|_)polygons?$/i.test(item.id)) ||
      (pointLayers.length === 1 ? pointLayers[0] : null) ||
      (layers.length === 1 ? layers[0] : null);
    if (!layer || typeof layer.id !== 'string' || !layer.id) {
      throw new Error('Historic mine source-layer metadata is missing or ambiguous');
    }
    const bounds = [header.minLon, header.minLat, header.maxLon, header.maxLat];
    if (!bounds.every(Number.isFinite) || bounds[0] >= bounds[2] || bounds[1] >= bounds[3] ||
        !Number.isFinite(header.minZoom) || !Number.isFinite(header.maxZoom) ||
        header.minZoom > header.maxZoom) throw new Error('Invalid historic mine archive extent');
    datasets.historicMines = {
      url: 'pmtiles://' + url,
      sourceLayer: layer.id,
      minzoom: header.minZoom,
      maxzoom: header.maxZoom,
      bounds,
      ...(Object.hasOwn(layer.fields || {}, 'dep_id') ? { promoteId: 'dep_id' } : {})
    };
  } catch (error) {
    console.warn(`Historic mines metadata unavailable for ${stateCode}:`, error.message);
  }
  return datasets;
}

function requestHistoricMineDataset(stateCode, state) {
  if (state.historicMinesRequest || !WESTERN_PROSPECTOR_STATES.has(stateCode)) return;
  state.historicMinesRequest = prepareProspectorDatasets(stateCode, {
    datasets: { historicMines: state.discoveredHistoricMines }
  }).then((datasets) => {
    if (datasets.historicMines) {
      state.datasets.historicMines = datasets.historicMines;
      scheduleProspectorStateSync();
    } else {
      // Retry on the next map update after a transient metadata failure.
      state.historicMinesRequest = null;
    }
  });
}

function addProspectorSource(
  id,
  state,
  dataset,
  extra = {}
) {
  if (map.getSource(id)) return id;

  if (!dataset) return null;

  const source = {
    type: 'vector'
  };

  if (Array.isArray(dataset.tiles) && dataset.tiles.length) {
    source.tiles = dataset.tiles;
    source.minzoom = dataset.minzoom ?? 0;
    source.maxzoom = dataset.maxzoom ?? 18;
  } else if (typeof dataset.url === 'string' && dataset.url) {
    source.url = dataset.url;
  } else {
    const url = prospectorsDatasetUrl(state, dataset);
    if (!url) return null;
    source.url = url;
  }

  for (const key of ['minzoom', 'maxzoom', 'bounds']) {
    if (dataset[key] !== undefined) source[key] = dataset[key];
  }

  map.addSource(id, {
    ...source,
    ...extra
  });

  return id;
}

function initializeProspectorState(stateCode) {
  if (initializedProspectorStates.has(stateCode)) {
    return;
  }

  const groups = {};

  for (const group of PROSPECTOR_GROUP_NAMES) {
    groups[group] = [];
  }

  prospectorStateLayers.set(
    stateCode,
    groups
  );

  initializedProspectorStates.add(stateCode);
}

function addProspectorLayer({
  stateCode,
  group,
  templateId,
  source,
  sourceLayer
}) {
  const template = [...PROSPECTOR_STYLE_TEMPLATES, ...WITHDRAWAL_TEMPLATES]
    .find((layer) => layer.id === templateId);

  if (!template) {
    console.warn(
      `Prospector loader: template layer missing: ${templateId}`
    );

    return null;
  }

  const id = `prospector-${stateCode}-${templateId}`;

  if (map.getLayer(id)) {
    return id;
  }

  const clone =
    JSON.parse(JSON.stringify(template));

  clone.id = id;
  clone.source = source;

  // State historic-mine overview begins at zoom 6.5.
  // Leave Arizona's original template unchanged.
  if (
    group === 'historicMines' &&
    templateId === HISTORIC_MINES_ARCHIVE_LAYER_ID
  ) {
    clone.minzoom = 4;
  }

  if (sourceLayer) {
    clone['source-layer'] = sourceLayer;
  } else {
    delete clone['source-layer'];
  }

  clone.layout = {
    ...(clone.layout || {}),
    visibility: 'none'
  };

  const layers =
    map.getStyle().layers || [];

  const templateIndex =
    layers.findIndex(
      (layer) => layer.id === templateId
    );

  const beforeLayer =
    templateIndex >= 0
      ? layers
          .slice(templateIndex + 1)
          .find(
            (layer) =>
              !layer.id.startsWith('prospector-') &&
              map.getLayer(layer.id)
          )
      : null;

  map.addLayer(
    clone,
    beforeLayer?.id
  );

  if (group === 'historicMines' && templateId === HISTORIC_MINES_ARCHIVE_LAYER_ID) {
    const listeners = [['click', (event) => {
      const feature = event.features?.[0];
      if (!feature) return;
      new maplibregl.Popup({ offset: 12 }).setLngLat(feature.geometry.coordinates).setDOMContent(makeHistoricMinePopup(feature.properties)).addTo(map);
    }], ['mouseenter', () => { map.getCanvas().style.cursor = 'pointer'; }],
    ['mouseleave', () => { map.getCanvas().style.cursor = ''; }]];
    for (const [event, listener] of listeners) map.on(event, id, listener);
    prospectorLayerListeners.set(id, listeners);
  }

  const stateGroups =
    prospectorStateLayers.get(stateCode);

  if (
    stateGroups &&
    !stateGroups[group].includes(id)
  ) {
    stateGroups[group].push(id);
  }

  return id;
}

/*
 * This is important:
 *
 * We do NOT duplicate Arizona zoom constants here.
 *
 * The current Arizona style layer remains the authority. Its minzoom
 * and maxzoom are read directly, so every state automatically follows
 * the same display parameters.
 */
function prospectorTemplatesCanRender(
  templateIds
) {
  const zoom = map.getZoom();

  const styleLayers =
    [...PROSPECTOR_STYLE_TEMPLATES, ...WITHDRAWAL_TEMPLATES];

  const byId =
    new Map(
      styleLayers.map(
        (layer) => [layer.id, layer]
      )
    );

  return templateIds.some(
    (templateId) => {
      const layer = byId.get(templateId);

      if (!layer) return false;

      const minZoom =
        Number.isFinite(layer.minzoom)
          ? layer.minzoom
          : -Infinity;

      const maxZoom =
        Number.isFinite(layer.maxzoom)
          ? layer.maxzoom
          : Infinity;

      return (
        zoom >= minZoom &&
        zoom < maxZoom
      );
    }
  );
}

function prospectorToggleChecked(id) {
  return Boolean(
    document.querySelector(`#${id}`)?.checked
  );
}

/* AEM UNIVERSAL PLSS ROUTE RESOLUTION V1 */
function resolveProspectorPlss(stateCode, datasets, kind) {
  const key = kind === 'townships'
    ? 'plssTownships'
    : 'plssSections';

  return datasets[key] || datasets.plss || null;
}

const PROSPECTOR_STANDARD_GROUPS = Object.freeze({
  surfaceManagement: {
    suffix: 'surface-management',
    templates: SURFACE_MANAGEMENT_LAYER_IDS
  },
  claims: {
    suffix: 'claims',
    templates: NOT_CLOSED_CLAIMS_LAYER_IDS
  },
  plssTownships: {
    suffix: 'plss-townships',
    templates: PLSS_TOWNSHIPS_LAYER_IDS,
    plssKind: 'townships'
  },
  plssSections: {
    suffix: 'plss-sections',
    templates: PLSS_SECTIONS_LAYER_IDS,
    plssKind: 'sections'
  },
  historicMines: {
    suffix: 'historic-mines',
    templates: [HISTORIC_MINES_ARCHIVE_LAYER_ID],
    promoteId: 'dep_id'
  },
  parcels: {
    suffix: 'parcels',
    templates: PROPERTY_PARCELS_LAYER_IDS
  }
});

function attachProspectorStandardGroup(
  stateCode,
  state,
  group,
  datasets,
  prefix
) {
  const config = PROSPECTOR_STANDARD_GROUPS[group];

  if (!config) return false;

  const dataset = config.plssKind
    ? resolveProspectorPlss(
        stateCode,
        datasets,
        config.plssKind
      )
    : datasets[group];

  if (!dataset) return false;

  const source = addProspectorSource(
    `${prefix}-${config.suffix}`,
    state,
    dataset,
    dataset.promoteId
      ? { promoteId: dataset.promoteId }
      : {}
  );

  if (!source) return false;

  const sourceLayer =
    config.plssKind === 'townships'
      ? dataset.layer || dataset.townshipsLayer || dataset.sourceLayer
      : config.plssKind === 'sections'
        ? dataset.layer || dataset.sectionsLayer || dataset.sourceLayer
        : dataset.sourceLayer;

  for (const templateId of config.templates) {
    addProspectorLayer({
      stateCode,
      group,
      templateId,
      source,
      sourceLayer
    });
  }

  return true;
}

function ensureProspectorGroup(
  stateCode,
  state,
  group
) {
  initializeProspectorState(stateCode);

  const key =
    `${stateCode}:${group}`;

  const plssTemplates =
    group === 'plssTownships'
      ? PLSS_TOWNSHIPS_LAYER_IDS
      : group === 'plssSections'
        ? PLSS_SECTIONS_LAYER_IDS
        : null;

  const plssLayerIds = plssTemplates?.map(
    (templateId) => `prospector-${stateCode}-${templateId}`
  );

  if (readyProspectorGroups.has(key)) {
    if (
      !plssLayerIds ||
      plssLayerIds.every((id) => Boolean(map.getLayer(id)))
    ) {
      return true;
    }

    // A PLSS group is not ready if its layers are absent.
    readyProspectorGroups.delete(key);
  }

  const datasets =
    state.datasets || {};

  const prefix =
    `prospector-${stateCode}`;

  if (group === 'boundary') {
    const dataset = datasets.boundary;

    if (!dataset) return false;

    const source =
      addProspectorSource(
        `${prefix}-boundary`,
        state,
        dataset
      );

    if (!source) return false;

    addProspectorLayer({
      stateCode,
      group,
      templateId: 'state-boundary-line',
      source,
      sourceLayer: dataset.sourceLayer
    });
  }

  else if (PROSPECTOR_EXTRA_PLSS[group]) {
    const dataset = datasets[group];
    if (!dataset?.sourceLayer) return false;
    const config = PROSPECTOR_EXTRA_PLSS[group];
    const source = addProspectorSource(`${prefix}-${config.suffix}`, state, dataset);
    if (!source) return false;
    const id = `${prefix}-plss-${config.suffix}`;
    if (!map.getLayer(id)) {
      map.addLayer({
        id, source, 'source-layer': dataset.sourceLayer,
        type: config.point ? 'circle' : 'line',
        minzoom: dataset.minzoom ?? 0,
        layout: { visibility: 'none' },
        paint: config.point
          ? { 'circle-radius': 2.5, 'circle-color': '#c9f5ff', 'circle-stroke-width': 0.5, 'circle-stroke-color': '#173f4a' }
          : { 'line-color': '#9befff', 'line-width': 0.8, 'line-opacity': 0.75 }
      });
    }
    const layers = prospectorStateLayers.get(stateCode)[group];
    if (!layers.includes(id)) layers.push(id);
  }

  else if (group === 'withdrawals') {
    const dataset = datasets.withdrawals;
    if (!dataset) return false;
    let attached = false;
    for (const kind of ['authorized', 'pending']) {
      const part = dataset[kind] || (dataset.tiles || dataset.url ? dataset : null);
      if (!part) continue;
      const source = addProspectorSource(`${prefix}-withdrawals-${kind}`, state, part);
      if (!source) continue;
      const sourceLayer = dataset[kind]?.sourceLayer || dataset[`${kind}Layer`] || `withdrawals_${kind}`;
      for (const template of WITHDRAWAL_TEMPLATES.filter(item => item.id.startsWith(`withdrawals-${kind}-`))) {
        addProspectorLayer({ stateCode, group, templateId: template.id, source, sourceLayer });
      }
      attached = true;
    }
    if (!attached) return false;
  }

  else if (PROSPECTOR_STANDARD_GROUPS[group]) {
    if (!attachProspectorStandardGroup(
      stateCode,
      state,
      group,
      datasets,
      prefix
    )) {
      return false;
    }
  }

  else {
    return false;
  }

  if (plssLayerIds) {
    const missing = plssLayerIds.filter(
      (id) => !map.getLayer(id)
    );

    if (missing.length) {
      console.warn(
        `AEM PLSS attachment incomplete: ${key}`,
        { missing, source: `prospector-${stateCode}-plss` }
      );
      return false;
    }

    console.info(
      `AEM PLSS layers confirmed: ${key}`,
      plssLayerIds
    );
  }

  readyProspectorGroups.add(key);
  if (group === 'historicMines') applyHistoricMineVisitedStates();

  console.log(
    `Prospector dataset attached: ` +
    `${stateCode.toUpperCase()} / ${group}`
  );

  return true;
}

function prospectorGroupTemplates(group) {
  if (group === 'surfaceManagement') {
    return SURFACE_MANAGEMENT_LAYER_IDS;
  }

  if (group === 'claims') {
    return NOT_CLOSED_CLAIMS_LAYER_IDS;
  }

  if (group === 'withdrawals') {
    return [
      'withdrawals-authorized-fill',
      'withdrawals-authorized-outline',
      'withdrawals-pending-fill',
      'withdrawals-pending-outline'
    ];
  }

  if (group === 'plssTownships') {
    return PLSS_TOWNSHIPS_LAYER_IDS;
  }

  if (group === 'plssSections') {
    return PLSS_SECTIONS_LAYER_IDS;
  }

  if (group === 'historicMines') {
    return [
      HISTORIC_MINES_ARCHIVE_LAYER_ID
    ];
  }


  if (group === 'parcels') {
    return PROPERTY_PARCELS_LAYER_IDS;
  }

  return [];
}

function prospectorGroupToggleEnabled(group) {
  if (PROSPECTOR_EXTRA_PLSS[group]) return prospectorToggleChecked('plssSections');
  if (group === 'boundary') {
    return true;
  }

  if (group === 'surfaceManagement') {
    return prospectorToggleChecked(
      'surfaceManagement'
    );
  }

  if (group === 'claims') {
    return prospectorToggleChecked(
      'notClosedClaims'
    );
  }

  if (group === 'withdrawals') {
    return prospectorToggleChecked(
      'miningWithdrawals'
    );
  }

  if (group === 'plssTownships') {
    return prospectorToggleChecked(
      'plssTownships'
    );
  }

  if (group === 'plssSections') {
    return prospectorToggleChecked(
      'plssSections'
    );
  }

  if (group === 'historicMines') {
    return prospectorToggleChecked(
      'historicMines'
    );
  }


  if (group === 'parcels') {
    return prospectorToggleChecked(
      'propertyParcels'
    );
  }

  return false;
}

function prospectorGroupShouldRender(
  state,
  group
) {
  if (
    !prospectorsStateIntersectsView(
      state?.bounds
    )
  ) {
    return false;
  }

  if (!prospectorGroupToggleEnabled(group)) {
    return false;
  }

  if (group === 'boundary') {
    return true;
  }

  // Universal historic-mines overview begins at zoom 6.5.
  // Do not depend on unrelated style-layer eligibility.
  if (group === 'historicMines') {
    return map.getZoom() >= 6.5;
  }

  if (PROSPECTOR_EXTRA_PLSS[group]) {
    return Boolean(state.datasets?.[group]) && map.getZoom() >= (state.datasets[group].minzoom ?? 0);
  }

  const templates =
    prospectorGroupTemplates(group);

  return prospectorTemplatesCanRender(
    templates
  );
}

function syncProspectorStates() {
  // MapLibre can report the style as not fully loaded while
  // imagery and other resources are still being retrieved.
  // Check that our required style templates exist instead.
  const style = map.getStyle();
  if (!style?.layers) return;

  for (
    const [stateCode, state]
    of prospectorStateRegistry
  ) {
    const inView =
      prospectorsStateIntersectsView(
        state?.bounds
      );

    /*
     * Do absolutely nothing for untouched states.
     * This is what prevents all state archives from opening
     * during application startup.
     */
    if (
      !inView &&
      !initializedProspectorStates.has(
        stateCode
      )
    ) {
      continue;
    }

    if (inView) {
      initializeProspectorState(
        stateCode
      );
    }

    const groups =
      prospectorStateLayers.get(
        stateCode
      );

    if (!groups) continue;

    if (inView || PROSPECTOR_GROUP_NAMES.some(group => group !== 'boundary' && groups[group].length)) {
      scheduleOffscreenEviction(`prospector:${stateCode}`, state.bounds, inView,
        () => evictProspectorOverlays(stateCode));
    }

    for (
      const group
      of PROSPECTOR_GROUP_NAMES
    ) {
      const visible =
        prospectorGroupShouldRender(
          state,
          group
        );

      /*
       * This is the speed optimization:
       *
       * No PMTiles source is even added to MapLibre until
       * the group is actually capable of rendering.
       */
      if (visible) {
        if (group === 'historicMines' && !state.datasets?.historicMines) {
          requestHistoricMineDataset(stateCode, state);
        } else {
          ensureProspectorGroup(stateCode, state, group);
        }
      }

      setLayerVisibility(
        groups[group],
        visible
      );
    }
  }
}

/*
 * moveend / zoomend already mean the user has stopped moving.
 * requestAnimationFrame simply collapses duplicate events without
 * imposing the old extra 120 ms delay.
 */
let prospectorStateSyncScheduled = false;


function scheduleProspectorStateSync() {
  if (prospectorStateSyncScheduled) {
    return;
  }

  prospectorStateSyncScheduled = true;

  window.requestAnimationFrame(() => {
    prospectorStateSyncScheduled = false;
    syncProspectorStates();
  });
}

async function initializeProspectorStateLoader() {
  try {
    /* Canonical VM dataset registry: non-road state layers */
    const discovered = await loadStateDiscovery();
    const mergedStates = {};

    for (const [rawCode, incoming] of Object.entries(
      discovered.states || {}
    )) {
      const code = rawCode.toLowerCase();

      if (!/^[a-z]{2}$/.test(code)) continue;
      if (!incoming || typeof incoming !== 'object') continue;

      const bounds = incoming.bounds;

      if (!Array.isArray(bounds) ||
          bounds.length !== 4 ||
          !bounds.every(Number.isFinite) ||
          bounds[0] >= bounds[2] ||
          bounds[1] >= bounds[3]) continue;

      mergedStates[code] = {
        ...incoming,
        discoveredHistoricMines: incoming.datasets?.historicMines,
        datasets: prospectorVmDatasets(incoming)
      };
    }

    console.log('AEM VM state discovery loaded');

    for (
      const [stateCode, state]
      of Object.entries(
        mergedStates
      )
    ) {
      prospectorStateRegistry.set(
        stateCode.toLowerCase(),
        state
      );
    }

    console.log(
      `Prospector state registry loaded: ` +
      `${prospectorStateRegistry.size} state(s)`
    );

    syncProspectorStates();

    unifiedProspectorEventsEnabled = true;

    document.addEventListener(
      'change',
      (event) => {
        if ([
          'roadRendering',
          'surfaceManagement',
