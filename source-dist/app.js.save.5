let lastResearchTouchStart = 0;
map.on('contextmenu', (event) => {
  event.preventDefault();
  // iOS can send a context-menu event for the same touch-and-hold gesture.
  // Let the intentional mobile long-press handler below own that interaction.
  if (Date.now() - lastResearchTouchStart < 2000) return;
