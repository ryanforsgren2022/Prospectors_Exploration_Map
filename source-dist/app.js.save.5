const WESTERN_ROAD_GROUPS = Object.freeze({
  major: ['motorway', 'motorway_link', 'trunk', 'trunk_link'],
  state: ['primary', 'primary_link', 'secondary', 'secondary_link'],
  secondary: ['tertiary', 'tertiary_link', 'unclassified'],
