function firstResearchValue(attributes, keys) {
  for (const key of keys) {
    const value = attributes?.[key];
    if (value !== undefined && value !== null && String(value).trim() !== '') {
      return String(value).trim();
    }
  }
  return '';
}

function formatTownship(attributes = {}) {
  const label = firstResearchValue(attributes, ['TWNSHPLAB']);
  if (label) return label;

  const number = firstResearchValue(attributes, ['TWNSHPNO']);
  const direction = firstResearchValue(attributes, ['TWNSHPDIR']);

  return number ? `T${Number(number)}${direction}` : '';
}

function formatRange(attributes = {}) {
  const number = firstResearchValue(attributes, ['RANGENO']);
  const direction = firstResearchValue(attributes, ['RANGEDIR']);

  return number ? `R${Number(number)}${direction}` : '';
}

function formatSection(attributes = {}) {
  return firstResearchValue(
    attributes,
    ['FRSTDIVLAB', 'FRSTDIVNO', 'FRSTDIVTXT']
  );
}

function formatMeridian(attributes = {}) {
  return firstResearchValue(
    attributes,
    ['PRINMER', 'PRINMERCD', 'PRINMERID', 'MERIDIAN', 'PM']
  );
}

function formatAliquot(attributes = {}) {
  return firstResearchValue(
    attributes,
    ['SECDIVLAB', 'SECDIVTXT', 'SECDIVNO', 'SECDIVTYP']
  );
}

function appendClaimResults(nodes, claims) {
  nodes.push(
    researchTextResult(
      'Claims at pin',
      claims.length ? String(claims.length) : 'none found'
    )
  );

  claims.forEach((feature, index) => {
    const a = feature.attributes || {};

    const parts = [
      a.CSE_NAME || 'Unnamed claim',
      a.CSE_NR || 'No case number',
      a.CSE_DISP || 'Status not listed'
    ];

    if (a.RCRD_ACRS) parts.push(`${a.RCRD_ACRS} acres`);

    nodes.push(
      researchTextResult(
        `Claim ${index + 1}`,
        parts.join(' · ')
      )
    );
  });
}

function appendWithdrawalResults(nodes, label, features) {
  nodes.push(
    researchTextResult(
      label,
      features.length ? String(features.length) : 'none found'
    )
  );

  features.forEach((feature, index) => {
    const a = feature.attributes || {};

    nodes.push(
      researchTextResult(
        `${label} ${index + 1}`,
        [
          a.CSE_NAME || 'Unnamed case',
          a.CSE_NR || 'No case number',
          a.CSE_DISP || 'Status not listed'
        ].join(' · ')
      )
    );
  });
}

async function openResearchLocation(lngLat) {
  const request = ++researchLocationRequest;

  activeResearchLocation = {
    lng: lngLat.lng,
    lat: lngLat.lat,
    name: 'Location research'
  };

  researchLocationCard.hidden = false;
  researchCoordinates.textContent =
    `${lngLat.lat.toFixed(5)}, ${lngLat.lng.toFixed(5)}`;
  researchResults.textContent = 'Researching location…';

  const checks = await Promise.allSettled([
    queryResearchLocation(
      NOT_CLOSED_CLAIMS_QUERY,
      lngLat,
      'CSE_NAME,CSE_NR,CSE_DISP,RCRD_ACRS'
    ),

    queryResearchLocation(
      SURFACE_MANAGEMENT_QUERY,
      lngLat,
      'CATEGORY,DESC_,ACRES'
    ),

    queryResearchLocation(
      WITHDRAWAL_AUTHORIZED_QUERY,
      lngLat,
      'CSE_NAME,CSE_NR,CSE_DISP,SEG_MIN'
    ),

    queryResearchLocation(
      WITHDRAWAL_PENDING_QUERY,
      lngLat,
      'CSE_NAME,CSE_NR,CSE_DISP,SEG_MIN'
    ),

    Promise.resolve(null), // Legacy live ArcGIS parcel lookup retired.
    countyAtPoint(lngLat),

    queryResearchLocation(
      PLSS_TOWNSHIPS_QUERY,
      lngLat,
      '*'
    ),

    queryResearchLocation(
      PLSS_SECTIONS_QUERY,
      lngLat,
      '*'
    ),

    queryResearchLocation(
      PLSS_ALIQUOT_QUERY,
      lngLat,
      '*'
    )
  ]);

  if (request !== researchLocationRequest) return;

  const claims = checks[0].status === 'fulfilled' ? checks[0].value : [];
  const surface = checks[1].status === 'fulfilled' ? checks[1].value : [];
  const authorized = checks[2].status === 'fulfilled' ? checks[2].value : [];
  const pending = checks[3].status === 'fulfilled' ? checks[3].value : [];
  const parcel = checks[4].status === 'fulfilled' ? checks[4].value : null;
  const county = checks[5].status === 'fulfilled' ? checks[5].value : null;
  const townships = checks[6].status === 'fulfilled' ? checks[6].value : [];
  const sections = checks[7].status === 'fulfilled' ? checks[7].value : [];
  const aliquots = checks[8].status === 'fulfilled' ? checks[8].value : [];

  const parcelProps = parcel?.properties || {};
  const townshipAttrs = townships[0]?.attributes || {};
  const sectionAttrs = sections[0]?.attributes || {};
  const aliquotAttrs = aliquots[0]?.attributes || {};
  const surfaceAttrs = surface[0]?.attributes || {};

  const township = formatTownship(townshipAttrs);
  const range = formatRange(townshipAttrs);
  const section = formatSection(sectionAttrs);

  const meridian =
    formatMeridian(townshipAttrs) ||
    formatMeridian(sectionAttrs) ||
    formatMeridian(aliquotAttrs);

  const aliquot = formatAliquot(aliquotAttrs);

  const locationNodes = [];

  locationNodes.push(
    researchTextResult(
      'Coordinates',
      `${lngLat.lat.toFixed(5)}, ${lngLat.lng.toFixed(5)}`
    )
  );

  locationNodes.push(
    researchTextResult(
      'City / Place',
      parcelProps.AZ_PlaceName || 'not available'
    )
  );

  locationNodes.push(
    researchTextResult(
      'County',
      county || 'not available'
    )
  );

  locationNodes.push(
    researchTextResult(
      'Principal Meridian',
      meridian || 'not available'
    )
  );

  locationNodes.push(
    researchTextResult(
      'Township',
      township || 'not available'
    )
  );

  locationNodes.push(
    researchTextResult(
      'Range',
      range || 'not available'
    )
  );

  locationNodes.push(
    researchTextResult(
      'Section',
      section || 'not available'
    )
  );

  locationNodes.push(
    researchTextResult(
      'Aliquot / Government Lot',
      aliquot || 'not available for this location'
    )
  );

  const mlrsNodes = [];

  appendClaimResults(mlrsNodes, claims);

  const legalDescription = [
    meridian && `Meridian ${meridian}`,
    township,
    range,
    section && `Section ${section}`,
    aliquot && `Aliquot ${aliquot}`
  ].filter(Boolean).join(' · ');

  mlrsNodes.push(
    researchTextResult(
      'Search location',
      legalDescription || 'PLSS information unavailable'
    )
  );

  mlrsNodes.push(
    researchLinkResult(
      'BLM records',
      'Open MLRS Mining Claims Geographic Report',
      MLRS_GEOGRAPHIC_REPORT_URL
    )
  );

  const landStatusNodes = [];

  landStatusNodes.push(
    researchTextResult(
      'Surface management',
      surface.length
        ? `${surfaceAttrs.CATEGORY || 'Not listed'} · ${surfaceAttrs.DESC_ || 'No description'}`
        : 'none found'
    )
  );

  appendWithdrawalResults(
    landStatusNodes,
    'Authorized / Interim withdrawals',
    authorized
  );

  appendWithdrawalResults(
    landStatusNodes,
    'Pending withdrawals',
    pending
  );

  const propertyNodes = [];

  if (parcel) {
    propertyNodes.push(
      researchTextResult(
        'Parcel APN',
        parcelProps.AZ_APN || 'not listed'
      )
    );

    propertyNodes.push(
      researchTextResult(
        'Parcel address',
        parcelProps.AZ_Address ||
          parcelProps.AZ_PlaceName ||
          'not listed'
      )
    );

    if (county && COUNTY_ASSESSORS[county]) {
      propertyNodes.push(
        researchLinkResult(
          'Parcel records',
          `Open ${county} County Assessor`,
          COUNTY_ASSESSORS[county]
        )
      );
    }
  } else {
    propertyNodes.push(
      researchTextResult(
        'Private parcel',
        'none found at pin'
      )
    );
  }

  researchPages = [
    {
      title: 'Location / PLSS',
      nodes: locationNodes
    },
    {
      title: 'MLRS / BLM',
      nodes: mlrsNodes
    },
    {
      title: 'Land Status',
      nodes: landStatusNodes
    },
    {
      title: 'Property',
      nodes: propertyNodes
    }
  ];

  researchPageIndex = 0;
  renderResearchPage();
}





