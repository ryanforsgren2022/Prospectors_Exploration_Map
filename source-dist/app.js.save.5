function researchTextResult(label, value) {
  const row = document.createElement('p');
  row.className = 'research-location__result';

  const title = document.createElement('b');
  title.textContent = `${label}: `;

  row.append(title, document.createTextNode(value || 'not available'));
  return row;
}

function researchLinkResult(label, text, href) {
  const row = document.createElement('p');
  row.className = 'research-location__result';

  const title = document.createElement('b');
  title.textContent = `${label}: `;

  const link = document.createElement('a');
