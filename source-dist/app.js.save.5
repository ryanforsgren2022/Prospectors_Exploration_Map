    const flyTo = document.createElement('button');
    flyTo.type = 'button';
    flyTo.textContent = 'View';
    flyTo.addEventListener('click', () => {
      map.easeTo({ center: [location.lng, location.lat], zoom: Math.max(map.getZoom(), 14), duration: 650, essential: false });
      savedLocationMarkers.get(location.id)?.togglePopup();
    });
    const remove = document.createElement('button');
    remove.type = 'button';
    remove.className = 'saved-location__delete';
    remove.textContent = 'Delete';
    remove.addEventListener('click', () => {
      savedLocations = savedLocations.filter((saved) => saved.id !== location.id);
      savedLocationMarkers.get(location.id)?.remove();
      savedLocationMarkers.delete(location.id);
      persistSavedLocations();
      renderSavedLocations();
    });
    actions.append(flyTo, remove);
    row.append(actions);
    savedLocationsList.append(row);
  });
}

