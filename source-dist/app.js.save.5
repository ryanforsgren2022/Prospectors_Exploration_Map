function makeHistoricMinePopup(properties = {}) {
  const content = document.createElement('article');
  content.className = 'historic-mine-popup';
  const title = document.createElement('h3');
  title.textContent = properties.site_name || properties.name || 'Historic mine or occurrence';
  content.append(title);
  [['Commodity', properties.commod1 || properties.commodity], ['Status', properties.dev_stat || properties.status], ['Record ID', properties.dep_id || properties.record_id]].forEach(([label, value]) => {
    if (!value) return;
    const line = document.createElement('p');
    line.textContent = `${label}: ${value}`;
    content.append(line);
  });
  if (properties.source_url) {
    const source = document.createElement('a');
    source.className = 'historic-mine-popup__source';
    source.href = properties.source_url;
    source.target = '_blank';
    source.rel = 'noopener noreferrer';
    source.textContent = properties.source_label || 'Open source record ↗';
    content.append(source);
  }
  if (properties.dep_id) {
    const visitedButton = document.createElement('button');
    const updateVisitedButton = (visited) => {
      visitedButton.textContent = visited ? 'Visited ✓' : 'Mark as visited';
      visitedButton.classList.toggle('is-visited', visited);
      visitedButton.setAttribute('aria-pressed', String(visited));
    };
    visitedButton.type = 'button';
    visitedButton.className = 'historic-mine-popup__visited';
    updateVisitedButton(visitedHistoricMineIds.has(String(properties.dep_id)));
    visitedButton.addEventListener('click', () => updateVisitedButton(setHistoricMineVisited(properties.dep_id, !visitedHistoricMineIds.has(String(properties.dep_id)))));
    content.append(visitedButton);
  }
  return content;
}

