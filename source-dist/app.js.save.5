function surfaceManagementCategoryExpression() {
  let expression = 'Unknown';
  for (const [field, aliases] of Object.entries(SURFACE_MANAGEMENT_ALIASES).reverse()) {
    const value = ['upcase', ['to-string', ['coalesce', ['get', field], '']]];
    const entries = Object.entries(aliases);
    const recognized = ['match', value, entries.map(([alias]) => alias), true, false];
    const condition = field === 'SMA_ID'
      ? ['all', ['!', ['any', ...Object.keys(SURFACE_MANAGEMENT_ALIASES).filter(name => name !== 'SMA_ID').map(name => ['has', name])]], recognized]
      : recognized;
    expression = ['case', condition,
      ['match', value, ...entries.flatMap(([alias, category]) => [alias, category]), 'Unknown'], expression];
  }
  return expression;
}

function surfaceManagementColorExpression() {
  return ['match', surfaceManagementCategoryExpression(),
    ...Object.entries(SURFACE_CATEGORY_COLORS).flatMap(([category, color]) => [category, color]),
    'rgb(190,190,190)'];
}

function visibleSurfaceManagementFilter() {
  return ['!', ['match', surfaceManagementCategoryExpression(), HIDDEN_SURFACE_CATEGORIES, true, false]];
}

